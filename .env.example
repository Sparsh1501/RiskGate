# Copy to .env and adjust paths as needed.

# Where kagglehub caches/downloads land; optional override for data symlink target
RISKGATE_DATA_DIR=./data/raw

# Time-based split boundaries (fractions of sorted TransactionDT range)
RISKGATE_TRAIN_FRAC=0.70
RISKGATE_VAL_FRAC=0.15
# test = remainder

# Fraud vs false-decline cost ratio (cost_fn / cost_fp); see docs/EVALUATION.md
RISKGATE_COST_FN=100.0
RISKGATE_COST_FP=1.0

# Target false-positive rate for recall@FPR reporting
RISKGATE_TARGET_FPR=0.01

# MLflow (used when stack is up; optional for offline train)
MLFLOW_TRACKING_URI=http://localhost:5000
